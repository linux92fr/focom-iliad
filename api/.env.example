# Set these in the backend service environment settings.
# Never commit real credentials or put DATABASE_URL in a VITE_ variable.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require
# Brevo API key for contact-form email notifications. Configure as a secret in Cloudflare.
BREVO_API_KEY=
# Exact public frontend origin, once the production domain is connected.
CORS_ORIGIN=https://focom-iliad.fr
# Sevalla supplies PORT automatically; this is for local development only.
PORT=3001
